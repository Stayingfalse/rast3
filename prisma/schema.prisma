generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Post {
  id          Int      @id @default(autoincrement())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([name])
  @@index([createdById], map: "Post_createdById_fkey")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model User {
  id                   String               @id @default(cuid())
  name                 String?
  email                String?              @unique
  emailVerified        DateTime?
  image                String?
  amazonWishlistUrl    String?
  wishlistViews        Int                  @default(0)
  firstName            String?
  lastName             String?
  profileCompleted     Boolean              @default(false)
  profileCompletedAt   DateTime?
  workEmail            String?              @unique
  adminLevel           AdminLevel           @default(USER)
  accounts             Account[]
  createdAuthProviders AuthProvider[]
  moderatedKudos       Kudos[]              @relation("KudosModerator")
  kudosGiven           Kudos[]
  posts                Post[]
  purchases            Purchase[]
  sessions             Session[]
  shareCards           ShareCard[]
  assignedLinks        WishlistAssignment[] @relation("AssignedUser")
  ownedWishlist        WishlistAssignment[] @relation("WishlistOwner")
  reports              WishlistReport[]
  memberships          Membership[]
  createdGroups        Group[]              @relation("GroupCreator")
  giftPages            GiftPage[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WishlistAssignment {
  id                String           @id @default(cuid())
  assignedUserId    String
  archived          Boolean          @default(false)
  wishlistOwnerId   String
  assignedAt        DateTime         @default(now())
  isActive          Boolean          @default(true)
  isCrossDepartment Boolean          @default(false)
  /// friends/community group it was picked up in (Day 14); null = workplace
  groupId           String?
  purchases         Purchase?
  assignedUser      User             @relation("AssignedUser", fields: [assignedUserId], references: [id], onDelete: Cascade)
  wishlistOwner     User             @relation("WishlistOwner", fields: [wishlistOwnerId], references: [id], onDelete: Cascade)
  group             Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  reports           WishlistReport[]

  @@unique([assignedUserId, wishlistOwnerId])
  @@index([groupId])
  @@index([assignedUserId])
  @@index([wishlistOwnerId])
  @@index([isActive])
}

model Purchase {
  id                   String             @id @default(cuid())
  userId               String
  wishlistAssignmentId String             @unique
  purchasedAt          DateTime           @default(now())
  notes                String?
  kudos                Kudos[]
  shareCard            ShareCard?
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishlistAssignment   WishlistAssignment @relation(fields: [wishlistAssignmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([wishlistAssignmentId])
}

model WishlistReport {
  id                   String             @id @default(cuid())
  userId               String
  wishlistAssignmentId String
  reportType           ReportType
  description          String?
  reportedAt           DateTime           @default(now())
  resolved             Boolean            @default(false)
  resolvedAt           DateTime?
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishlistAssignment   WishlistAssignment @relation(fields: [wishlistAssignmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([wishlistAssignmentId])
  @@index([reportType])
  @@index([resolved])
}

model Kudos {
  id          String     @id @default(cuid())
  userId      String
  purchaseId  String?
  message     String     @db.Text
  images      String     @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  hidden      Boolean    @default(false)
  moderatedAt DateTime?
  moderatedBy String?
  moderator   User?      @relation("KudosModerator", fields: [moderatedBy], references: [id])
  purchase    Purchase?  @relation(fields: [purchaseId], references: [id])
  shareCard   ShareCard?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([purchaseId])
  @@index([hidden])
  @@index([moderatedBy])
}

model AuthProvider {
  id              String   @id @default(cuid())
  name            String   @unique
  displayName     String
  clientId        String?
  clientSecret    String?
  enabled         Boolean  @default(false)
  isEmailProvider Boolean  @default(false)
  emailConfig     Json? // For email provider specific settings
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String
  creator         User     @relation(fields: [createdBy], references: [id])

  @@index([enabled])
  @@index([createdBy])
}

/// A public, shareable card for one gift sent or one thank-you posted. The id
/// is a random code used in the share URL; it reveals nothing about the
/// recipient. Deleting the gift or thank-you deletes its card.
model ShareCard {
  id         String        @id
  kind       ShareCardKind
  userId     String
  purchaseId String?       @unique
  kudosId    String?       @unique
  /// Group cards: "org:<groupId>" or "team:<groupId>", one card per group
  groupKey   String?       @unique
  /// Group cards: the name shown on the card, chosen by the organiser
  label      String?
  views      Int           @default(0)
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase   Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  kudos      Kudos?        @relation(fields: [kudosId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ShareCardKind {
  SENT
  THANKS
  ORG
  TEAM
}

/// Site admins run the whole site; organisers are group ADMIN memberships
enum AdminLevel {
  SITE
  USER
}

enum ReportType {
  NO_ITEMS
  DOESNT_EXIST
  NO_ADDRESS
  OTHER
}

/// A Christmas season. One site-wide season a year (mid-Nov to early Jan);
/// `year` is the year the season opens in.
model Season {
  id        String   @id @default(cuid())
  year      Int      @unique
  opensAt   DateTime
  closesAt  DateTime
  createdAt DateTime @default(now())
}

/// A group people give within: a work organisation (ORG), a team inside one
/// (TEAM, child of an ORG), a community such as a Discord server (COMMUNITY)
/// or a friends group (FRIENDS). Replaces Domain/Department (Day 8 backfill;
/// queries move over on Day 9).
model Group {
  id             String               @id @default(cuid())
  kind           GroupKind
  name           String
  slug           String               @unique
  status         GroupStatus          @default(PENDING)
  description    String?
  parentId       String?
  /// ORG groups: the email domain members join with (legacy Domain.name)
  emailDomain    String?              @unique
  joinCode       String?              @unique
  /// COMMUNITY groups: the Discord server members join through (Day 13)
  discordGuildId String?              @unique
  /// optional Discord role required to join
  discordRoleId  String?
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  parent         Group?               @relation("GroupTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       Group[]              @relation("GroupTree")
  createdBy      User?                @relation("GroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships    Membership[]
  assignments    WishlistAssignment[]
  /// Amazon affiliate links in this group: the site default for its kind, or forced on/off
  affiliate      AffiliateMode        @default(DEFAULT)
  affiliateTags  AffiliateTag[]
  giftPages      GiftPage[]

  @@index([parentId])
  @@index([kind, status])
  @@index([createdById])
}

model Membership {
  id       String         @id @default(cuid())
  groupId  String
  userId   String
  role     MembershipRole @default(MEMBER)
  joinedAt DateTime       @default(now())
  group    Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

enum GroupKind {
  ORG
  TEAM
  COMMUNITY
  FRIENDS
}

/// PENDING groups wait for a site admin's approval (owner, 18 Oct)
enum GroupStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum MembershipRole {
  MEMBER
  ADMIN
}

/// Amazon Associates settings (one row, id "site"). Site admins only.
model AffiliateSettings {
  id               String   @id @default("site")
  /// master switch: nothing is tagged while this is off
  enabled          Boolean  @default(false)
  /// the account's default tracking ID, used when a group has none this season
  defaultTag       String   @default("raosanta04-21")
  /// defaults for groups left on DEFAULT, by kind (teams follow their workplace)
  orgDefault       Boolean  @default(false)
  communityDefault Boolean  @default(true)
  friendsDefault   Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

enum AffiliateMode {
  DEFAULT
  ON
  OFF
}

/// A group's own Amazon tracking ID for one season (created in Associates Central)
model AffiliateTag {
  id      String @id @default(cuid())
  groupId String
  season  Int
  tag     String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, season])
}

/// The public page a picked-up wishlist is opened from when affiliate links are
/// on: one fixed, unguessable address per wishlist, group and season, so the
/// referring page Amazon sees is public (Associates rules). Shows no names.
model GiftPage {
  /// the unguessable token in /gift/<id>
  id        String   @id
  ownerId   String
  groupId   String
  season    Int
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([ownerId, groupId, season])
  @@index([groupId])
}

/// Archive of the retired Domain/Department tables and User.domain,
/// departmentId, adminLevel (organiser levels) and adminScope (20 Oct 2026).
/// Read-only, kept until the 2026 season has run on groups; nothing reads it.
model LegacyDomain {
  id          String   @id
  name        String
  enabled     Boolean
  description String?
  createdById String?
  createdAt   DateTime

  @@map("_legacy_Domain")
}

model LegacyDepartment {
  id        String   @id
  name      String
  domain    String
  createdAt DateTime

  @@map("_legacy_Department")
}

model LegacyUserOrg {
  userId       String  @id
  domain       String?
  departmentId String?
  adminLevel   String
  adminScope   String?

  @@map("_legacy_UserOrg")
}
